# Telegram Bot Token (від @BotFather)
BOT_TOKEN=your_bot_token_here

# Telegram User ID адміністратора (можна вказати декілька через кому)
ADMIN_ID=123456789

# Telegram ID групи (якщо використовується для сповіщень)
GROUP_ID=-1001234567890

# Supabase REST API URLs
SUPABASE_TRIPS_URL=https://your-project.supabase.co/rest/v1/trips
SUPABASE_PARTICIPANTS_URL=https://your-project.supabase.co/rest/v1/trip_participants

# Supabase API Key
SUPABASE_KEY=your_supabase_api_key_here
